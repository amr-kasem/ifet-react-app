# The bootstrap config belongs to the web root, never to the bundle. The dev
# server borrows it via src/setupProxy.js; a copy left in public/ would be
# copied into build/ and shadow the real one on the rig.
/public/config.json
/public/configCommonValves.json
/public/configCommonSensors.json
